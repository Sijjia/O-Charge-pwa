# API URL: backend FastAPI/OCPP
VITE_API_URL=https://ocpp.asystem.ai

# WebSocket — прямое соединение
VITE_WEBSOCKET_URL=wss://ocpp.asystem.ai

# Supabase (self-hosted на supabase.asystem.ai)
VITE_SUPABASE_URL=https://supabase.asystem.ai
VITE_SUPABASE_ANON_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJzdXBhYmFzZSIsImlhdCI6MTc3NzcyNjIwMCwiZXhwIjo0OTMzMzk5ODAwLCJyb2xlIjoiYW5vbiJ9.Z1eHcqvK32Z_DfznoZ9lPF4iYQUqpyvc4BjtcITK6bo

# Auth mode (cookie session via backend)
VITE_AUTH_MODE=cookie

# VAPID public key (для web push)
VITE_VAPID_PUBLIC_KEY=BJkQwaGjlqOWzeiSLfkcPyVI6YU-MNkw8erW5ZWBy0SIJaz3MmwEAOPMtqqgbsQrENd-E2uJFp9KFPca

# 2GIS карта
VITE_2GIS_API_KEY=17896a11-2d90-4cd6-8698-37299195692e

# Demo Mode — для демонстрации заказчикам и локального тестирования
# Автоматически выключается при сборке для production (см .env.production)
VITE_DEMO_MODE=false

# Auth: enable cookie refresh (evp_access expires in 10min, evp_refresh in 7 days)
VITE_ENABLE_AUTH_REFRESH=true

# Keycloak SSO (staff/admin login)
VITE_KEYCLOAK_BASE_URL=https://sso.asystem.kg
VITE_KEYCLOAK_REALM=asystem
VITE_KEYCLOAK_CLIENT_ID=ocharge
VITE_SSO_ENABLED=false

# Dev Login — кнопки быстрого входа по ролям на /auth (для staging/демо)
# На реальном production выставить false или убрать
VITE_ALLOW_DEV_LOGIN=true
